# Credentials for the shared internal-tool login.
# Override these in your deployment (Vercel → Project → Settings → Environment Variables)
# or in a local .env.local file. The defaults are also hardcoded in src/lib/auth.ts
# so the app works out of the box — rotate them by setting these env vars.
AUTH_EMAIL=team@example.com
AUTH_PASSWORD=change-me

# Long random string used to HMAC-sign the auth cookie.
# Rotate this to invalidate every existing session.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
